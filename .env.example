# GPS-FAMILIA server configuration
# Copy to .env and fill in values. start.py / Start.bat do this automatically.

PORT=3000
HOST=0.0.0.0

# When true (default for local), OTP codes are returned in the API so the app
# works without Twilio/SMTP. Set to false in production.
OTP_ECHO=true

# Optional email delivery for OTPs and welcome messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@gps-familia.local

# Optional Twilio SMS for OTPs
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Looks like: 1234567890-abcdef.apps.googleusercontent.com
# Add http://localhost:3000 and your https://live-url as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Web Push (lock-screen notifications). Leave blank to auto-create keys on first boot.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_MAILTO=mailto:familia@localhost

# Demo sample family (Vito, Sonny, …). Set false in production.
DEMO_MODE=true
DEMO_PASSWORD=demo123

# Comma-separated extra CORS origins. localhost is always allowed.
# In production only these (plus same-origin) may call the API.
CORS_ORIGIN=

# Optional persist path (Docker sets /data/f360_data.json).
# DATA_FILE=

# Stripe (cards). Leave blank for the PCI-safe demo vault (last4 only, no PAN).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Plaid (bank login). Leave blank for demo institution picker (no routing numbers).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Voice/video: leave blank for peer-to-peer WebRTC + Google STUN.
# For group calls / strict NATs, point at a LiveKit SFU (see DEVELOPER.txt / DEPLOY.txt I2).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional TURN if two phones on carrier data cannot connect P2P.
TURN_URL=
TURN_USER=
TURN_PASS=

# Optional external Matrix homeserver. Not required — signaling uses /ws.
MATRIX_HOMESERVER=
