# GPS-FAMILIA server configuration
# Copy to .env and fill in values. start.py / Start.bat do this automatically.

PORT=3000
HOST=0.0.0.0

# When true (default for local), OTP codes are returned in the API so the app
# works without Twilio/SMTP. Set to false in production.
OTP_ECHO=true

# Optional email delivery for OTPs and welcome messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@gps-familia.local

# Optional Twilio SMS for OTPs
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Looks like: 1234567890-abcdef.apps.googleusercontent.com
# Add http://localhost:3000 and your https://live-url as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Web Push (lock-screen notifications). Leave blank to auto-create keys on first boot.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_MAILTO=mailto:familia@localhost
